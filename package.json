{
  "name": "netflix-couch-remote",
  "version": "2.2.10",
  "private": true,
  "type": "module",
  "description": "Control Netflix in desktop Chrome from your Android phone: player and catalog.",
  "license": "MIT",
  "scripts": {
    "build": "npm run build:ext && npm run build:remote",
    "build:ext": "node scripts/build-extension.mjs && node scripts/third-party-licenses.mjs extension/dist",
    "build:remote": "vite build && node scripts/third-party-licenses.mjs remote/dist",
    "dev:remote": "vite --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/run.mjs",
    "docs:screenshots": "npm run build && mkdir -p docs/img && E2E_SCREENSHOTS=docs/img node tests/e2e/run.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.0",
    "@types/qrcode": "^1.5.6",
    "aedes": "^1.2.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.1",
    "peer": "^1.0.2",
    "playwright": "^1.56.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "ws": "^8.22.0"
  },
  "dependencies": {
    "mqtt": "^5.16.0",
    "peerjs": "^1.5.5",
    "preact": "^10.29.8",
    "qrcode": "^1.5.4"
  }
}
